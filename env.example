# Telegram Bot ayarları (Mütləqdir)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=@kanalinizin_adi_ve_ya_chat_id

# AI API açarları (Ən azı biri mütləqdir; hər ikisi olarsa avtomatik ehtiyat keçid işləyir)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# İstəyə bağlı model və davranış ayarları
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=llama-3.3-70b-versatile
MAX_POSTS_PER_RUN=5
MAX_ITEMS_PER_FEED=10
MEMORY_DAYS=7
HISTORY_RETENTION_DAYS=14
ONLY_VERIFIED=false
DRY_RUN=false
